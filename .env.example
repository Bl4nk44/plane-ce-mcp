# Runtime configuration for the Plane MCP Server.
# Copy to .env and fill in real values. Never commit .env.
# Test configuration lives separately in .env.test (copy to .env.test.local).

# --- Core (all transports) ------------------------------------------------
# Plane API base URL. Self-host: your instance URL, e.g. http://192.168.1.10:8800
PLANE_BASE_URL=https://api.plane.so
# Optional: internal URL preferred for server-to-server calls (Docker networks).
#PLANE_INTERNAL_BASE_URL=http://plane-api:8000

# --- stdio mode (required) ------------------------------------------------
PLANE_API_KEY=your_personal_access_token
PLANE_WORKSPACE_SLUG=your_workspace_slug

# --- HTTP mode ------------------------------------------------------------
# PAT header auth (/http/api-key/mcp) needs no extra configuration — clients
# send x-api-key (or Authorization: Bearer) + x-workspace-slug headers.
# OAuth + SSE endpoints start only when the OAuth provider is configured:
#PLANE_OAUTH_PROVIDER_CLIENT_ID=
#PLANE_OAUTH_PROVIDER_CLIENT_SECRET=
#PLANE_OAUTH_PROVIDER_BASE_URL=http://localhost:8211
#PLANE_OAUTH_PROVIDER_ENABLE_CIMD=false
# Extra allowed OAuth redirect URI patterns (comma-separated), appended to the
# built-in allowlist — onboard new MCP clients without a release.
#PLANE_OAUTH_ALLOWED_REDIRECT_URIS=

# Optional path prefix for all HTTP routes (e.g. behind a reverse proxy).
#MCP_PATH_PREFIX=

# --- Token storage (HTTP/SSE, optional) -------------------------------------
# Redis for OAuth token storage; falls back to in-memory when unset.
#REDIS_HOST=localhost
#REDIS_PORT=6379

# --- Logging ----------------------------------------------------------------
# Include user display name (PII) in logs alongside the opaque user id.
#LOG_USER_INFO=false
