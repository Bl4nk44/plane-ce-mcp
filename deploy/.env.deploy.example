# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public domain served by Caddy (DNS A/AAAA record must point at this host).
MCP_PUBLIC_DOMAIN=plane-mcp.example.com

# --- Plane MCP Server runtime (same variables as the repo-root .env.example) --
PLANE_BASE_URL=http://192.168.1.10:8800
#PLANE_INTERNAL_BASE_URL=

# Internal-API adapter for pages on Community Edition (optional).
#PLANE_INTERNAL_API_EMAIL=
#PLANE_INTERNAL_API_PASSWORD=

# OAuth (optional — without it the server exposes PAT header auth only).
#PLANE_OAUTH_PROVIDER_CLIENT_ID=
#PLANE_OAUTH_PROVIDER_CLIENT_SECRET=
#PLANE_OAUTH_PROVIDER_BASE_URL=https://plane-mcp.example.com
#PLANE_OAUTH_ALLOWED_REDIRECT_URIS=

#REDIS_HOST=
#REDIS_PORT=6379
#LOG_USER_INFO=false
